# ------------------------------------------------------------------
# Meridian — copy this file to ".env" and fill in what you need.
# Every value has a working default, so the site runs with no .env at all.
# ------------------------------------------------------------------

# --- server ---
MERIDIAN_HOST=127.0.0.1
MERIDIAN_PORT=5001
MERIDIAN_DEBUG=true

# Used to sign things. Generate a real one before going live:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MERIDIAN_SECRET_KEY=change-me-before-launch

# --- database ---
# Where accounts, lesson requests and partnership enquiries are stored.
MERIDIAN_DB=backend/meridian.db

# --- email ---
# Leave SMTP blank while developing: verification codes are printed to the
# console, saved to backend/outbox/ and shown on the verification screen.
#
# Gmail example (use an App Password, not your normal password):
#   MERIDIAN_SMTP_HOST=smtp.gmail.com
#   MERIDIAN_SMTP_PORT=587
#   MERIDIAN_SMTP_USER=hello@meridian.ge
#   MERIDIAN_SMTP_PASSWORD=your-16-character-app-password
MERIDIAN_SMTP_HOST=
MERIDIAN_SMTP_PORT=587
MERIDIAN_SMTP_USER=
MERIDIAN_SMTP_PASSWORD=
MERIDIAN_SMTP_STARTTLS=true

MERIDIAN_MAIL_FROM=Meridian <no-reply@meridian.ge>

# Partnership enquiries from the Engage page land here.
MERIDIAN_TEAM_INBOX=hello@meridian.ge

# Show the verification code in the API response and on screen.
# Defaults to true while SMTP is unconfigured. Set to false in production.
# MERIDIAN_DEV_CODES=false

# --- auth ---
MERIDIAN_SESSION_DAYS=30
MERIDIAN_CODE_TTL=15
# Set to true once you serve the site over HTTPS.
MERIDIAN_COOKIE_SECURE=false

# --- payments ---
# "test" charges nothing and accepts the published test cards. Switch to a real
# provider (stripe, bog, tbc) once you have merchant credentials — see backend/payments.py.
MERIDIAN_PAYMENT_PROVIDER=test
# Fee added on top of every tutor's price. 0.10 = a 20 ₾ tutor is shown at 22 ₾.
MERIDIAN_PLATFORM_FEE=0.10

# Public address used in email buttons once the site is online.
# MERIDIAN_PUBLIC_URL=https://meridian.ge

# --- admin ---
# The token the /admin page asks for. Change it.
MERIDIAN_ADMIN_TOKEN=meridian-admin

# --- free tier limits ---
# How many tutors a signed-out visitor can see before the paywall.
MERIDIAN_FREE_TEACHERS=4
