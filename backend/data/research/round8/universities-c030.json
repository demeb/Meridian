  "id": "university-of-the-free-state",
  "name": {
   "en": "University of the Free State",
   "ka": "თავისუფალი შტატის უნივერსიტეტი",
   "ar": "جامعة الولاية الحرة"
  },
  "iso": "ZA",
  "city": "Bloemfontein",
  "lat": -29.109,
  "lon": 26.185,
  "type": "public",
  "website": "https://www.ufs.ac.za",
  "platform": "Direct online application (apply.ufs.ac.za)",
  "application_url": "https://apply.ufs.ac.za/Application/Start",
  "intakes": null,
  "deadline": null,
  "deadline_note": "2027 undergraduate applications open online on 1 April; closing dates differ by programme (selection programmes close earlier). A UFS dates table lists international undergraduate applications, but the closing date could not be read reliably.",
  "tuition_intl": null,
  "acceptance_rate": null,
  "students": null,
  "intl_pct": null,
  "languages": [
   "English",
   "Afrikaans"
  ],
  "english_bachelors": null,
  "qualifications": {
   "national": null,
   "a-level": "accepted",
   "ib": null,
   "us-diploma": null
  },
  "qualifications_note": {
   "en": "International applicants need a Universities South Africa (USAf) Certificate of Exemption, assessed from Grade 11/O-level and Grade 12/AS-level results. The UFS international office can apply to USAf on your behalf.",
   "ka": "საერთაშორისო აპლიკანტებს სჭირდებათ სამხრეთ აფრიკის უნივერსიტეტების (USAf) გათავისუფლების სერტიფიკატი, რომელიც ფასდება მე-11 კლასისა და მე-12 კლასის (AS-level) შედეგებით. UFS-ის საერთაშორისო ოფისს შეუძლია USAf-ში განაცხადის გაგზავნა თქვენი სახელით.",
   "ar": "يحتاج المتقدمون الدوليون إلى شهادة إعفاء من اتحاد الجامعات في جنوب أفريقيا (USAf) تُقيَّم بناءً على نتائج الصف الحادي عشر ومستوى AS للصف الثاني عشر. يمكن لمكتب الشؤون الدولية في الجامعة التقدم بالطلب إلى USAf نيابة عنك."
  },
  "sat": {
   "low": null,
   "high": null,
   "required": null
  },
  "ielts_min": null,
  "toefl_min": null,
  "duolingo_min": null,
  "other_tests": null,
  "fields": [
   "medicine-health",
   "natural-sciences",
   "law",
   "education"
  ],
  "strengths": null,
  "summary": {
   "en": "A public university in Bloemfontein, South Africa, teaching mainly in English. International bachelor applicants apply online and need a USAf Certificate of Exemption; fees are in the programme price list.",
   "ka": "სახელმწიფო უნივერსიტეტი ბლუმფონტეინში, სამხრეთ აფრიკა, სწავლება ძირითადად ინგლისურად. საერთაშორისო აპლიკანტები განაცხადს ონლაინ აგზავნიან და სჭირდებათ USAf-ის სერტიფიკატი.",
   "ar": "جامعة حكومية في بلومفونتين بجنوب أفريقيا، التدريس فيها بالإنجليزية غالباً. يقدّم الطلاب الدوليون طلبهم عبر الإنترنت ويحتاجون إلى شهادة إعفاء من USAf."
  },
  "about": null,
  "aid_intl": null,
  "tests": {
   "en": "The 2027 prospectus names no entrance test for non-selection programmes; selection programmes have their own selection process. Admission rests on school results and the USAf exemption.",
   "ka": "2027 წლის პროსპექტუსი არ ასახელებს მისაღებ გამოცდას არასელექციური პროგრამებისთვის; სელექციურ პროგრამებს საკუთარი შერჩევა აქვს. მიღება ეფუძნება სკოლის შედეგებსა და USAf გათავისუფლებას.",
   "ar": "لا يذكر دليل 2027 اختباراً للقبول للبرامج غير الانتقائية؛ وللبرامج الانتقائية عملية اختيار خاصة. يعتمد القبول على نتائج المدرسة وإعفاء USAf."
  },
  "gpa_note": {
   "en": "Evaluation uses Grade 11 and mid-year Grade 12 (or O-level and AS-level) results; meeting minimum requirements does not guarantee admission, and a conditional offer is re-evaluated on final results.",
   "ka": "შეფასება ეფუძნება მე-11 და მე-12 კლასის შუა წლის (ან O/AS-level) შედეგებს; მინიმალური მოთხოვნების დაკმაყოფილება მიღებას არ გარანტირებს, პირობითი შეთავაზება საბოლოო შედეგებით გადაისინჯება.",
   "ar": "يعتمد التقييم على نتائج الصف الحادي عشر ومنتصف الصف الثاني عشر (أو O-level وAS-level)؛ استيفاء الحد الأدنى لا يضمن القبول، ويُعاد تقييم العرض المشروط بالنتائج النهائية."
  },
  "requirements": [
   {
    "key": "passport",
    "label": {
